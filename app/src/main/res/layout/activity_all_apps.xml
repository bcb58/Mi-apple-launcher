<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base">

    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/wall_1" />

    <View
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_gravity="top"
        android:background="@drawable/scrim_top" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/overscan_vertical"
            android:paddingStart="@dimen/overscan_horizontal"
            android:paddingEnd="@dimen/overscan_horizontal"
            android:paddingBottom="14dp"
            android:text="@string/all_apps_title"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:fontFamily="sans-serif-medium" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="@dimen/overscan_horizontal"
            android:paddingEnd="@dimen/overscan_horizontal"
            android:paddingTop="@dimen/card_overshoot"
            android:paddingBottom="@dimen/overscan_vertical"
            android:descendantFocusability="afterDescendants"
            android:overScrollMode="never"
            android:scrollbars="none" />
    </LinearLayout>
</FrameLayout>
