<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/topBarRoot"
    android:layout_width="match_parent"
    android:layout_height="@dimen/topbar_height"
    android:paddingStart="@dimen/overscan_horizontal"
    android:paddingEnd="@dimen/overscan_horizontal"
    android:paddingTop="@dimen/overscan_vertical"
    android:clipChildren="false">

    <LinearLayout
        android:id="@+id/tabs"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="center_horizontal"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tabHome"
            style="@style/TopTab"
            app:drawableStartCompat="@drawable/ic_home"
            android:text="@string/tab_home" />

        <TextView
            android:id="@+id/tabApps"
            style="@style/TopTab"
            app:drawableStartCompat="@drawable/ic_apps"
            android:text="@string/tab_apps" />

        <TextView
            android:id="@+id/tabSettings"
            style="@style/TopTab"
            app:drawableStartCompat="@drawable/ic_settings"
            android:text="@string/tab_settings" />
    </LinearLayout>

    <TextView
        android:id="@+id/clock"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:gravity="center_vertical"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/clock_text_size"
        android:fontFamily="sans-serif-medium" />
</FrameLayout>
